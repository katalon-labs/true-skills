{
  "id": "analyze-file-defect",
  "skill": "analyze-failures",
  "description": "Triage a failed execution and file one defect. The agent checks for a linked defect, asks for the missing summary, previews, files once after a yes, and reads the link back.",
  "fixture": "default",
  "turns": [
    {
      "text": "Triage failed execution 9001. If you find a product bug, I want a defect filed for it."
    },
    {
      "text": "The lockout failure is a real product bug. Use the suggested title."
    },
    {
      "text": "Yes, file it.",
      "confirms": true
    }
  ],
  "assertions": [
    {
      "id": "skill",
      "type": "skill-loaded",
      "skill": "analyze-failures"
    },
    {
      "id": "results-read-first",
      "type": "order",
      "before": {
        "tool": "find_test_results"
      },
      "after": {
        "tool": "create_defect"
      }
    },
    {
      "id": "duplicate-checked",
      "type": "order",
      "before": {
        "tool": "fetch_defects"
      },
      "after": {
        "tool": "create_defect"
      }
    },
    {
      "id": "integration-looked-up",
      "type": "order",
      "before": {
        "tool": "list_alm_integrations"
      },
      "after": {
        "tool": "create_defect"
      }
    },
    {
      "id": "summary-asked",
      "type": "asked-before",
      "tool": "create_defect",
      "question": [
        "summary|title"
      ]
    },
    {
      "id": "title-from-user",
      "type": "user-said-before",
      "tool": "create_defect",
      "scope": "any",
      "patterns": [
        "title"
      ]
    },
    {
      "id": "defect-filed",
      "type": "called",
      "tool": "create_defect",
      "match": {
        "test_result_id": 55001
      },
      "max": 1
    },
    {
      "id": "no-rerun",
      "type": "not-called",
      "tool": "rerun_execution"
    },
    {
      "id": "defect-read-back",
      "type": "read-back",
      "after": {
        "tool": "create_defect"
      },
      "reads": [
        "fetch_defects"
      ],
      "sameArgs": [
        "project_id"
      ],
      "resultMustMatch": [
        "\"defectKey\":\\s*\"CEL-231\""
      ]
    }
  ]
}
