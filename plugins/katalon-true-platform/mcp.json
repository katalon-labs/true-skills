{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "katalon-prod-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://<your.sub.domain>.katalon.io/mcp",
        "--transport",
        "http-first"
      ]
    }
  }
}
